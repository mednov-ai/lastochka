# One rendered file per environment. Values are restricted and substituted by deployment tooling.
limit_req_zone $binary_remote_addr zone=__LIMIT_ZONE__:1m rate=1r/m;
limit_req_zone $server_name zone=__LIMIT_ZONE___global:1m rate=2r/s;

server {
    listen 80;
    server_name __HOSTNAME__;
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root __ACME_ROOT__;
        default_type text/plain;
    }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name __HOSTNAME__;
    access_log off;
    ssl_certificate __CERTIFICATE__;
    ssl_certificate_key __CERTIFICATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    # Browsers send Origin: null for form submissions under no-referrer;
    # strict-origin preserves the CSRF origin check without exposing paths.
    add_header Referrer-Policy strict-origin always;
    limit_req_status 429;

    location = / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:__GATE_PORT__/__gate/;
    }
    location = /__gate/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:__GATE_PORT__;
    }
    location = /__gate/logo.svg {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:__GATE_PORT__;
    }
    location = /__gate/login {
        limit_req zone=__LIMIT_ZONE__ burst=4 nodelay;
        limit_req zone=__LIMIT_ZONE___global burst=4 nodelay;
        client_max_body_size 4k;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:__GATE_PORT__;
    }
    location = /__gate/logout {
        client_max_body_size 4k;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:__GATE_PORT__;
    }
    location ^~ /__gate/ { return 404; }

    location = /_lastochka_gate_auth {
        internal;
        proxy_pass http://127.0.0.1:__GATE_PORT__/__gate/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
    }
    location @access_required { return 302 /__gate/; }
    location / {
        auth_request /_lastochka_gate_auth;
        error_page 401 = @access_required;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:__APP_PORT__;
    }
}
