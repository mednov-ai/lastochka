{
  "name": "lastochka-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "npm run check:ui-language && react-router build",
    "start": "node server.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "api:generate": "openapi-typescript ../api/openapi.json -o app/api/schema.d.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app tests *.ts server.mjs",
    "format:check": "prettier --check app tests *.ts server.mjs",
    "check:ui-language": "node ../scripts/ui-language/check.mjs",
    "test:ui-language": "node --test ../scripts/ui-language/check.test.mjs"
  },
  "dependencies": {
    "@react-router/express": "8.4.0",
    "@react-router/node": "8.4.0",
    "express": "5.3.0",
    "isbot": "5.2.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.4.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
