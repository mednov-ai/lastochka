# Copy to an ignored file, chmod 600; replace all placeholders before remote use.
DATABASE_PASSWORD=replace-with-a-long-random-password
BACKEND_IMAGE=lastochka-backend:0.1.0
FRONTEND_IMAGE=lastochka-frontend:0.1.0
PUBLIC_APP_URL=https://play-and-say.ru/lastochka/
WEBAUTHN_ORIGIN=https://play-and-say.ru
WEBAUTHN_RP_ID=play-and-say.ru
COOKIE_SECURE=true
PREVIEW_PORT=18080

# New concept: random external generation; change on disaster restore.
ADMIN_ACCESS_GENERATION=replace-with-a-new-random-generation
# Configure privately when enabling Telegram delivery; intake works without these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Old email/attendance links are retired. Public inbox cannot be reopened by the new proxy.
LASTOCHKA_ENVIRONMENT=test-preview

# Browser push; generate a private VAPID key pair outside source control.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# Set false only for isolated migration or restore verification.
LASTOCHKA_WORKERS_ENABLED=true
