# Copy to a private .env file and replace the test DB password.
DATABASE_PASSWORD=replace-this-local-preview-password
BACKEND_IMAGE=lastochka-backend:0.1.0
FRONTEND_IMAGE=lastochka-frontend:0.1.0
PUBLIC_APP_URL=http://localhost:18080/lastochka/
WEBAUTHN_ORIGIN=http://localhost:18080
WEBAUTHN_RP_ID=localhost
COOKIE_SECURE=false
PREVIEW_PORT=18080

# Browser push; generate a private VAPID key pair outside source control.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# Set false only for isolated migration or restore verification.
LASTOCHKA_WORKERS_ENABLED=true
